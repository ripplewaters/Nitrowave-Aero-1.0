{
  "name": "nitrowave-aero",
  "version": "1.0.0",
  "description": "Nitrowave Aero — an audio-reactive, skinnable desktop music player built with Tauri 2, React and WebGL2.",
  "license": "MIT",
  "author": "Nitrowave",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ripplewaters/Nitrowave-Aero-1.0.git"
  },
  "bugs": {
    "url": "https://github.com/ripplewaters/Nitrowave-Aero-1.0/issues"
  },
  "homepage": "https://github.com/ripplewaters/Nitrowave-Aero-1.0#readme",
  "keywords": [
    "tauri",
    "react",
    "music-player",
    "webgl",
    "shader",
    "audio-visualizer",
    "desktop-app"
  ],
  "engines": {
    "node": ">=22"
  },
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "node scripts/build-desktop.mjs",
    "landing:dev": "vite --config vite.landing.config.ts",
    "landing:build": "tsc -b && vite build --config vite.landing.config.ts",
    "release:stage": "node scripts/stage-release.mjs",
    "notices": "node scripts/third-party-notices.mjs",
    "release:build": "node scripts/third-party-notices.mjs && tauri build && npm run release:stage && npm run landing:build"
  },
  "dependencies": {
    "@fontsource/audiowide": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@tauri-apps/api": "^2.8.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
